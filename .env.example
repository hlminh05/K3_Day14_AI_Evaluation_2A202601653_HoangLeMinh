# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, choose a provider, then replace its placeholder key.
GENERATION_PROVIDER=openai

# OpenAI provider
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Gemini provider (set GENERATION_PROVIDER=gemini to use these values)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MIN_REQUEST_INTERVAL=4.1
